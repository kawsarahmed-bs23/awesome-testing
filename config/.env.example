# Baseline environment template. Copy to config/.env.<env> (local|dev|staging|prod) and adjust.
# ENV is set by the npm scripts via cross-env; BASE_URL etc. may be overridden by real env vars (CI secrets).
BASE_URL=https://the-internet.herokuapp.com
API_URL=https://the-internet.herokuapp.com
# Public demo credentials published by the-internet.herokuapp.com
ADMIN_USERNAME=tomsmith
ADMIN_PASSWORD=SuperSecretPassword!
